<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ReflexRenamer.Core\ReflexRenamer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReflexRenamer</AssemblyName>
    <AssemblyTitle>Reflex Renamer</AssemblyTitle>
    <!-- exe のアイコン（Reflex Renamer 用に描いた A→B。原本の 64.ico ではない） -->
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Reflex Renamer</Product>
    <Copyright>Inspired by Flexible Renamer by Naru</Copyright>
    <!-- フォームはデザイナーを使わずコードで組み立てるので、デザイナー向けのシリアル化の警告は出さない -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- exe から抽出したダイアログ・メニューの定義（FrTools res-dump で生成） -->
    <EmbeddedResource Include="..\..\docs\spec\resources.json" LogicalName="resources.json" />
    <!-- exe から抽出したアイコンとビットマップ（同じく res-dump で生成） -->
    <EmbeddedResource Include="Assets\Icons\*.ico" LogicalName="Icons/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Bitmaps\*.bmp" LogicalName="Bitmaps/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- データファイル（言語ファイル、プリセット、タグ定義、スクリプト）は exe と同じフォルダに置く。設定（ini）とログは実行時に作られる。
         オリジナル版の配布物から取り込み、製品名などを Reflex Renamer 向けに直したもの -->
    <None Include="Data\*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- ヘルプ（HTML。日本語と英語）。help\ja\index.html などに置き、既定のブラウザーで開く -->
    <None Include="Help\**" Link="help\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
